{
  "name": "@kawarimidoll/textdb",
  "version": "0.0.0",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "textdb.ts",
      "jsondb.ts",
      "deno.jsonc",
      "LICENSE",
      "README.md"
    ]
  },
  "exclude": ["cov_profile", "z-ai"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/uuid": "jsr:@std/uuid@^1.1.1"
  },
  "tasks": {
    "test": "deno test --allow-net",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "cov": "deno test --allow-net --coverage=cov_profile && deno coverage cov_profile",
    "ci": "deno lint && deno fmt --check && deno test --allow-net && deno publish --dry-run --allow-dirty"
  }
}
