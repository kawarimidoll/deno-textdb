{
  "exclude": ["cov_profile", "z-ai"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/uuid": "jsr:@std/uuid@^1"
  },
  "tasks": {
    "test": "deno test --allow-net",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "cov": "deno test --allow-net --coverage=cov_profile && deno coverage cov_profile",
    "ci": "deno lint && deno fmt --check && deno test --allow-net"
  }
}
